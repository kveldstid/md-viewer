<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows RIDs are required by src/MISX-Install (MSIX packaging), which
         builds the app for a concrete runtime identifier. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
    <CommunityToolkitMvvmVersion>8.4.2</CommunityToolkitMvvmVersion>
    <MarkdigVersion>1.3.2</MarkdigVersion>
    <TextMateSharpVersion>2.0.4</TextMateSharpVersion>
    <MermaiderVersion>0.12.2</MermaiderVersion>
    <SvgControlsSkiaAvaloniaVersion>12.0.0.17</SvgControlsSkiaAvaloniaVersion>
    <CSharpMathAvaloniaVersion>12.0.0</CSharpMathAvaloniaVersion>
  </PropertyGroup>

</Project>
