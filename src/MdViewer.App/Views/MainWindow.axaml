<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MdViewer.App.ViewModels"
        xmlns:views="using:MdViewer.App.Views"
        xmlns:rendering="using:MdViewer.Rendering"
        mc:Ignorable="d"
        x:Class="MdViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KT Markdown Viewer"
        Icon="/Assets/MdViewer.ico"
        Width="1280" Height="860"
        MinWidth="640" MinHeight="420"
        Background="{DynamicResource ShellBackgroundBrush}"
        FontFamily="{DynamicResource BodyFontFamily}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFilesCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenFolderCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleFindBarCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding Find.NextMatchCommand}" />
    <KeyBinding Gesture="Shift+F3" Command="{Binding Find.PreviousMatchCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding ShowQuickOpenCommand}" />
    <KeyBinding Gesture="Ctrl+Home" Command="{Binding ShowStartPageCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding DismissOverlaysCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleViewModeCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
    <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding CloseAllTabsCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ToggleFocusModeCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowSettingsCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding OpenHelpPageCommand}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding ReturnFromFootnoteCommand}" />
  </Window.KeyBindings>

  <DockPanel LastChildFill="True">

    <!-- ========================= Top chrome ========================= -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,6,6,0">

        <ToggleButton Grid.Column="0"
                      Classes="icon"
                      Margin="0,0,6,6"
                      IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}"
                      IsVisible="{Binding CanToggleSidebar}"
                      ToolTip.Tip="Toggle sidebar (Ctrl+B)">
          <Path Width="14" Height="14" Stretch="Uniform"
                Data="M3 3 H21 V21 H3 Z M9 3 V21"
                Stroke="{DynamicResource TextSecondaryBrush}"
                StrokeThickness="1.6"
                Fill="Transparent" />
        </ToggleButton>

        <!-- Home: the way back to the start page while tabs are open (5.14) -->
        <Button Grid.Column="1"
                Classes="icon"
                Margin="0,0,6,6"
                Command="{Binding ShowStartPageCommand}"
                ToolTip.Tip="Start page (Ctrl+Home)">
          <Path Width="14" Height="14" Stretch="Uniform"
                Data="M3 11 L12 3 L21 11 M5 10 V21 H19 V10"
                Stroke="{DynamicResource TextSecondaryBrush}"
                StrokeThickness="1.6"
                Fill="Transparent" />
        </Button>

        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ListBox x:Name="TabStrip"
                   Classes="tab-strip"
                   ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentTabViewModel">
                <Border Padding="12,7,6,7" MinWidth="120" MaxWidth="220">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">

                    <Ellipse Grid.Column="0"
                             Width="6" Height="6"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource CalloutWarningAccentBrush}"
                             IsVisible="{Binding IsModifiedOnDisk}"
                             ToolTip.Tip="Changed on disk" />

                    <TextBlock Grid.Column="1"
                               Classes="tab-title"
                               Text="{Binding Title}"
                               ToolTip.Tip="{Binding FullPath}" />

                    <Button Grid.Column="2"
                            Classes="icon"
                            Padding="3"
                            Width="18" Height="18"
                            Content="✕"
                            FontSize="9"
                            ToolTip.Tip="Close (Ctrl+W)"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <Grid Grid.Column="3" Margin="6,0,0,6">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
            <Button Classes="icon" Content="Open" FontSize="12"
                    Command="{Binding OpenFilesCommand}"
                    ToolTip.Tip="Open file (Ctrl+O)" />
            <Button Classes="icon" Content="Help" FontSize="12"
                    Command="{Binding OpenHelpPageCommand}"
                    ToolTip.Tip="Open help page (F1)" />
            <Button Classes="icon" Content="About" FontSize="12"
                    Command="{Binding ShowAboutCommand}"
                    ToolTip.Tip="About this application" />
            <Button Classes="icon" Content="🔍" FontSize="12"
                    Command="{Binding ToggleFindBarCommand}"
                    ToolTip.Tip="Find (Ctrl+F)" />
            <Button x:Name="ThemeButton" Classes="icon" FontSize="14"
                    Content="🌓"
                    Command="{Binding CycleThemeCommand}"
                    ToolTip.Tip="Switch theme (System → Light → Dark)" />
            <Button Classes="icon" FontSize="14"
                    Content="⚙"
                    Command="{Binding ShowSettingsCommand}"
                    ToolTip.Tip="Settings (Ctrl+,)" />
          </StackPanel>

          <Popup IsOpen="{Binding IsThemePopupVisible}"
                 Placement="Bottom"
                 PlacementTarget="{Binding #ThemeButton}"
                 IsLightDismissEnabled="False"
                 HorizontalOffset="0"
                 VerticalOffset="4">
            <Border Background="{DynamicResource ShellChromeBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4">
              <TextBlock Classes="md-caption" Text="{Binding ThemePopupText}" />
            </Border>
          </Popup>
        </Grid>
      </Grid>
    </Border>

    <!-- ========================= Status bar ========================= -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,1,0,0"
            IsVisible="{Binding Settings.ShowStatusBar}"
            Padding="12,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="status"
                     Text="{Binding StatusMessage}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="status"
                     Text="{Binding SelectedTab.FullPath}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Border Classes="segmented" Margin="0,0,12,0"
                  IsVisible="{Binding SelectedTab.HasDocument, FallbackValue=False}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment"
                           Content="Preview"
                           GroupName="ViewMode"
                           IsChecked="{Binding SelectedTab.IsPreviewMode, Mode=OneWay}"
                           Command="{Binding ShowPreviewCommand}"
                           ToolTip.Tip="Rendered document (Ctrl+E toggles)" />
              <RadioButton Classes="segment"
                           Content="Raw"
                           GroupName="ViewMode"
                           IsChecked="{Binding SelectedTab.IsSourceMode, Mode=OneWay}"
                           Command="{Binding ShowSourceCommand}"
                           ToolTip.Tip="Markdown source, read-only (Ctrl+E toggles)" />
            </StackPanel>
          </Border>

          <TextBlock Classes="status" Margin="0,0,12,0"
                     Text="{Binding SelectedTab.WordCount, StringFormat='{}{0:N0} words'}" />
          <TextBlock Classes="status" Margin="0,0,12,0" Text="{Binding SelectedTab.EncodingDisplay}" />
          <TextBlock Classes="status" Margin="0,0,12,0" Text="{Binding SelectedTab.LineEndingDisplay}" />
          <Button Classes="status" Command="{Binding ZoomOutCommand}" Content="−"
                  ToolTip.Tip="Zoom out (Ctrl+-)" />
          <Button Classes="status" Command="{Binding ZoomResetCommand}"
                  Content="{Binding SelectedTab.ZoomDisplay}"
                  ToolTip.Tip="Reset zoom (Ctrl+0)" />
          <Button Classes="status" Command="{Binding ZoomInCommand}" Content="+"
                  ToolTip.Tip="Zoom in (Ctrl++)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========================= Body ========================= -->
    <Grid x:Name="BodyGrid">
      <!--
        The sidebar column is pixel-sized rather than Auto so the splitter can
        actually resize it: a GridSplitter changes column widths, and an Auto
        column sized by a fixed-width child has nothing to change. The column is
        collapsed to zero in code-behind when the sidebar is hidden, since a
        pixel column does not collapse on its own the way an Auto one does.
      -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180" MaxWidth="640" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ====================== Sidebar ====================== -->
      <Border Grid.Column="0"
              Background="{DynamicResource ShellBackgroundBrush}"
              IsVisible="{Binding IsSidebarPresent}">
        <Grid x:Name="SidebarGrid" RowDefinitions="*,Auto,1.2*">

          <Grid x:Name="ExplorerSection" Grid.Row="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="14,10,10,6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="sidebar-header" Text="EXPLORER" />
                <TextBlock Grid.Column="1" Classes="sidebar-header"
                           Text="{Binding WorkspaceName}" Opacity="0.8" />
              </Grid>
            </Border>

            <Panel Grid.Row="1">
              <TreeView x:Name="FileTree"
                        Classes="sidebar"
                        ItemsSource="{Binding WorkspaceRoots}">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:FileTreeItemViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}"
                                    x:DataType="vm:FileTreeItemViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                      <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" />
                      <TextBlock Classes="tree-text"
                                 Classes.dim="{Binding IsDirectory}"
                                 Text="{Binding Name}"
                                 ToolTip.Tip="{Binding FullPath}" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                  <ContextMenu Opening="OnFileTreeContextMenuOpening">
                    <MenuItem x:Name="OpenInEditorMenuItem"
                              Header="Open in editor"
                              Click="OnOpenTreeItemInEditorClick" />
                    <Separator />
                    <MenuItem x:Name="RevealInFileManagerMenuItem"
                              Header="Show in File Explorer"
                              Click="OnRevealTreeItemClick" />
                    <MenuItem x:Name="CopyFullPathMenuItem"
                              Header="Copy full path"
                              Click="OnCopyTreeItemPathClick" />
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>

              <StackPanel Margin="16,10" Spacing="8"
                          IsVisible="{Binding !HasWorkspace}">
                <TextBlock Classes="tree-text dim" TextWrapping="Wrap"
                           Text="No folder open." />
                <Button Classes="start-action" Content="Open folder…"
                        Command="{Binding OpenFolderCommand}" />
              </StackPanel>
            </Panel>
          </Grid>

          <GridSplitter x:Name="SidebarSplitter" Grid.Row="1" Height="1" Background="{DynamicResource ShellBorderBrush}"
                        ResizeDirection="Rows" />

          <Grid x:Name="OutlineSection" Grid.Row="2" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="14,10,10,6">
              <TextBlock Classes="sidebar-header" Text="OUTLINE" />
            </Border>

            <Panel Grid.Row="1">
              <TreeView Classes="sidebar"
                        x:Name="OutlineTree"
                        ItemsSource="{Binding SelectedTab.Outline}"
                        SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:OutlineItemViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}"
                                    x:DataType="vm:OutlineItemViewModel">
                    <TextBlock Classes="tree-text"
                               Margin="0,2"
                               FontWeight="{Binding LevelWeight}"
                               Text="{Binding Title}" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>

              <TextBlock Classes="tree-text dim"
                         Margin="16,8"
                         TextWrapping="Wrap"
                         Text="No headings in this document."
                         IsVisible="{Binding !SelectedTab.HasOutline, FallbackValue=False}" />
            </Panel>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4"
                    Background="{DynamicResource ShellBorderBrush}"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    IsVisible="{Binding IsSidebarPresent}"
                    ToolTip.Tip="Drag to resize the sidebar" />

      <!-- ====================== Document pane ====================== -->
      <Panel x:Name="DocumentPane" Grid.Column="2" Background="{DynamicResource ContentBackgroundBrush}">

        <!-- The rendered document -->
        <ScrollViewer x:Name="DocumentScroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding SelectedTab.ShowsPreview, FallbackValue=False}">
          <rendering:MarkdownPresenter x:Name="Presenter"
                                       Document="{Binding SelectedTab.Document}"
                                       AllowRemoteImages="{Binding SelectedTab.AllowRemoteImages, FallbackValue=False}"
                                       FindMatches="{Binding Find.Matches}"
                                       AllowTaskListEditing="{Binding Settings.EnableTaskListEditing, FallbackValue=False}"
                                        ZoomFactor="{Binding SelectedTab.Zoom, FallbackValue=1.0}"
                                       ContentMaxWidth="{Binding Settings.EffectiveContentMaxWidth}" />
        </ScrollViewer>

        <!-- Raw source, read-only (5.15) -->
        <views:SourceView x:Name="Source"
                          ZoomFactor="{Binding SelectedTab.Zoom, FallbackValue=1.0}"
                          IsVisible="{Binding SelectedTab.ShowsSource, FallbackValue=False}" />

        <!-- Load failure: the tab stays open and explains itself (6.4) -->
        <StackPanel Margin="40,80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    MaxWidth="460"
                    Spacing="10"
                    IsVisible="{Binding SelectedTab.HasError, FallbackValue=False}">
          <TextBlock Classes="md-h3" HorizontalAlignment="Center" Text="Could not open this document" />
          <TextBlock Classes="md-body"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding SelectedTab.LoadError}" />
          <Button Classes="start-action" HorizontalAlignment="Center"
                  Content="Try again" Command="{Binding ReloadCommand}" />
        </StackPanel>

        <!--
          The start view and its recent documents (5.14). It is the empty state
          when no tabs are open, and is also reachable from Home at any time, in
          which case it covers the document rather than replacing it.
        -->
        <views:StartView IsVisible="{Binding IsStartPageVisible}" />

        <!-- Find bar overlay (5.7): it does not reflow the document -->
        <Border Classes="find-bar"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,24,0"
                IsVisible="{Binding IsFindBarVisible}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="FindInput"
                     Classes="find-input"
                     Watermark="Find in document"
                     Text="{Binding Find.Query, Mode=TwoWay}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding Find.NextMatchCommand}" />
                <KeyBinding Gesture="Shift+Enter" Command="{Binding Find.PreviousMatchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>

            <TextBlock Classes="status"
                       MinWidth="72"
                       Margin="4,0"
                       Text="{Binding Find.MatchSummary}" />

            <Button Classes="icon" Content="∧" Command="{Binding Find.PreviousMatchCommand}"
                    ToolTip.Tip="Previous match (Shift+F3)" />
            <Button Classes="icon" Content="∨" Command="{Binding Find.NextMatchCommand}"
                    ToolTip.Tip="Next match (F3)" />

            <Border Width="1" Background="{DynamicResource ShellBorderBrush}" Margin="4,2" />

            <ToggleButton Classes="icon" Content="Aa" IsChecked="{Binding Find.MatchCase, Mode=TwoWay}"
                          ToolTip.Tip="Match case" />
            <ToggleButton Classes="icon" Content="ab" IsChecked="{Binding Find.WholeWord, Mode=TwoWay}"
                          ToolTip.Tip="Whole word" />
            <ToggleButton Classes="icon" Content=".*" IsChecked="{Binding Find.UseRegex, Mode=TwoWay}"
                          ToolTip.Tip="Regular expression" />

            <Button Classes="icon" Content="✕" FontSize="10"
                    Command="{Binding CloseFindBarCommand}"
                    ToolTip.Tip="Close (Esc)" />
          </StackPanel>
        </Border>

        <!-- Quick-open palette (5.9 / 5.14) -->
        <Border Classes="quick-open"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,64,0,0"
                IsVisible="{Binding IsQuickOpenVisible}">
          <StackPanel Spacing="2">

            <TextBox Classes="quick-open-input"
                     x:Name="QuickOpenInput"
                     Watermark="Go to file…"
                     Text="{Binding QuickOpen.Query, Mode=TwoWay}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Up" Command="{Binding SelectPreviousQuickOpenResultCommand}" />
                <KeyBinding Gesture="Down" Command="{Binding SelectNextQuickOpenResultCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding AcceptQuickOpenCommand}" />
              </TextBox.KeyBindings>
            </TextBox>

            <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,0">
              <TextBlock Grid.Column="0" Classes="sidebar-header"
                         Text="{Binding QuickOpen.HeaderText}" />
              <TextBlock Grid.Column="1" Classes="md-caption"
                         Text="Enter to open · Esc to dismiss" />
            </Grid>

            <ListBox Classes="quick-open-results"
                     ItemsSource="{Binding QuickOpen.Results}"
                     SelectedItem="{Binding QuickOpen.SelectedResult, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickOpenResultViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Classes="quick-open-title" Text="{Binding Title}" />
                      <TextBlock Classes="quick-open-path" Text="{Binding Directory}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="recent-badge"
                            IsVisible="{Binding IsRecent}">
                      <TextBlock Text="RECENT" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="md-caption"
                       Margin="10,10,10,6"
                       IsVisible="{Binding !QuickOpen.HasResults}"
                       Text="No matching file. Open a folder to build the index." />

            <StackPanel Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Classes="start-action" Content="Open"
                      Command="{Binding AcceptQuickOpenCommand}" />
              <Button Classes="start-action" Content="Cancel"
                      Command="{Binding CloseQuickOpenCommand}" />
            </StackPanel>

          </StackPanel>
        </Border>

        <!-- Settings page (5.13): fills the pane instead of a modal dialog -->
        <views:SettingsView IsVisible="{Binding IsSettingsVisible}" />

        <!-- About page: fills the pane, same pattern as settings -->
        <views:AboutView IsVisible="{Binding IsAboutVisible}" />

        <!-- Wait popup while a document is loading: blocks the pane until done -->
        <Border Classes="loading-scrim"
                IsVisible="{Binding SelectedTab.IsLoading, FallbackValue=False}">
          <Border Classes="loading-card"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Spacing="12">
              <TextBlock Classes="md-body"
                         HorizontalAlignment="Center"
                         Text="Loading document…" />
              <TextBlock Classes="md-caption"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{Binding SelectedTab.Title}" />
              <ProgressBar IsIndeterminate="True" Width="220" />
            </StackPanel>
          </Border>
        </Border>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
