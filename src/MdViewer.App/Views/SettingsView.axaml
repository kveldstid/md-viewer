<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MdViewer.App.ViewModels"
             mc:Ignorable="d"
             x:Class="MdViewer.App.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource ContentBackgroundBrush}">

  <!--
    Settings page (SPECIFICATION.md 5.13).

    This is the UI surface for settings.json. The controls are bound to
    SettingsViewModel but do not act on anything yet: persistence and the
    live effects land with session restore in M6.
  -->

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720"
                HorizontalAlignment="Center"
                Margin="40,32,40,64"
                Spacing="8">

      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Classes="md-h2" Text="Settings" />
        <Button Grid.Column="1"
                Classes="icon"
                Content="✕"
                FontSize="11"
                VerticalAlignment="Center"
                Command="{Binding CloseSettingsCommand}"
                ToolTip.Tip="Close settings (Esc)" />
      </Grid>

      <TextBlock Classes="md-caption"
                 TextWrapping="Wrap"
                 Margin="0,0,0,16"
                 Text="Preferences are stored in settings.json. Saving is not wired up yet — these controls preview the surface." />

      <!-- ====================== Appearance ====================== -->
      <TextBlock Classes="md-h4" Text="Appearance" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <Grid ColumnDefinitions="220,*" RowDefinitions="Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Theme" />
        <ComboBox Grid.Column="1"
                  MinWidth="220"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Settings.ThemeOptions}"
                  SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" />
      </Grid>

      <!-- ======================== Panels ======================== -->
      <TextBlock Classes="md-h4" Text="Panels" Margin="0,12,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Show explorer"
                IsChecked="{Binding Settings.ShowExplorerPanel, Mode=TwoWay}" />
      <CheckBox Content="Show outline"
                IsChecked="{Binding Settings.ShowOutlinePanel, Mode=TwoWay}" />
      <CheckBox Content="Show status bar"
                IsChecked="{Binding Settings.ShowStatusBar, Mode=TwoWay}" />

      <!-- ====================== Typography ====================== -->
      <TextBlock Classes="md-h4" Text="Typography" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <Grid ColumnDefinitions="220,*" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Body font" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox MinWidth="220"
                    ItemsSource="{Binding Settings.BodyFontOptions}"
                    SelectedItem="{Binding Settings.BodyFontFamily, Mode=TwoWay}" />
          <NumericUpDown Width="120"
                         Minimum="9" Maximum="32" Increment="1"
                         FormatString="0"
                         Value="{Binding Settings.BodyFontSize, Mode=TwoWay}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="220,*" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Monospace font" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox MinWidth="220"
                    ItemsSource="{Binding Settings.MonospaceFontOptions}"
                    SelectedItem="{Binding Settings.MonospaceFontFamily, Mode=TwoWay}" />
          <NumericUpDown Width="120"
                         Minimum="8" Maximum="28" Increment="1"
                         FormatString="0"
                         Value="{Binding Settings.MonospaceFontSize, Mode=TwoWay}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="220,*" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Line height" />
        <NumericUpDown Grid.Column="1"
                       Width="120"
                       HorizontalAlignment="Left"
                       Minimum="1.0" Maximum="2.5" Increment="0.05"
                       FormatString="0.00"
                       Value="{Binding Settings.LineHeight, Mode=TwoWay}" />
      </Grid>

      <Grid ColumnDefinitions="220,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Content width" />
        <NumericUpDown Grid.Column="1"
                       Width="120"
                       HorizontalAlignment="Left"
                       Minimum="480" Maximum="2000" Increment="20"
                       FormatString="0"
                       IsEnabled="{Binding !Settings.UseFullWidth}"
                       Value="{Binding Settings.ContentMaxWidth, Mode=TwoWay}" />
      </Grid>

      <CheckBox Content="Use the full window width"
                IsChecked="{Binding Settings.UseFullWidth, Mode=TwoWay}" />

      <!-- ======================= Rendering ====================== -->
      <TextBlock Classes="md-h4" Text="Rendering" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Smart punctuation (… – — “curly quotes”)"
                IsChecked="{Binding Settings.SmartPunctuation, Mode=TwoWay}" />

      <CheckBox Content="Allow ticking task list checkboxes (writes to the file)"
                ToolTip.Tip="Clicking a task list checkbox rewrites the [ ] or [x] marker in the document on disk."
                IsChecked="{Binding Settings.EnableTaskListEditing, Mode=TwoWay}" />

      <!-- ======================= Raw view ======================= -->
      <TextBlock Classes="md-h4" Text="Raw view" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Show line numbers"
                IsChecked="{Binding Settings.ShowLineNumbersInRawView, Mode=TwoWay}" />
      <CheckBox Content="Show front matter"
                IsChecked="{Binding Settings.ShowFrontMatter, Mode=TwoWay}" />

      <!-- ======================== Explorer ====================== -->
      <TextBlock Classes="md-h4" Text="Explorer" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Hide folders without Markdown files"
                ToolTip.Tip="Folders whose subtree contains no Markdown file are left out of the file tree."
                IsChecked="{Binding Settings.HideFoldersWithoutMarkdown, Mode=TwoWay}" />

      <!-- ========================= Editor ======================= -->
      <TextBlock Classes="md-h4" Text="Editor" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <TextBlock Classes="md-caption"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Text="The program used by &quot;Open in editor&quot; in the Explorer context menu. MdViewer stays a reader; editing happens here." />

      <Grid ColumnDefinitions="220,*,Auto">
        <TextBlock Grid.Column="0" Classes="md-body" VerticalAlignment="Center" Text="Default editor" />
        <TextBox Grid.Column="1"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 PlaceholderText="No editor chosen"
                 Text="{Binding Settings.DefaultEditorPath, Mode=TwoWay}" />
        <Button Grid.Column="2"
                Classes="start-action"
                VerticalAlignment="Center"
                Content="Browse…"
                Command="{Binding PickDefaultEditorCommand}" />
      </Grid>

      <!-- ==================== File watching ==================== -->
      <TextBlock Classes="md-h4" Text="File watching" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Watch open files for external changes"
                IsChecked="{Binding Settings.EnableFileWatching, Mode=TwoWay}" />

      <!-- ======================== Startup ======================= -->
      <TextBlock Classes="md-h4" Text="Startup" Margin="0,16,0,0" />
      <Border Classes="md-heading-rule" Margin="0,0,0,8" />

      <CheckBox Content="Open the previously used folder"
                IsChecked="{Binding Settings.ReopenPreviousFolder, Mode=TwoWay}" />

      <Button Classes="start-action"
              HorizontalAlignment="Left"
              Margin="0,16,0,0"
              Content="Close"
              Command="{Binding CloseSettingsCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
