<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MdViewer</AssemblyName>
    <RootNamespace>MdViewer.App</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Company>Kveldstid AS</Company>
    <Authors>Kveldstid AS</Authors>
    <Product>KT MD Viewer</Product>
    <Description>Markdown viewer</Description>
    <PackageProjectUrl>https://kveldstid.com</PackageProjectUrl>
    <RepositoryUrl>https://kveldstid.com</RepositoryUrl>
    <Copyright>Copyright © Kveldstid AS</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Windows executable icon (Explorer, taskbar, Alt-Tab). Regenerate with
         python design/icon/build-icons.py — never hand-edit the .ico. -->
    <ApplicationIcon>Assets\MdViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the Window can use it at runtime,
         which is what Linux window managers read. -->
    <AvaloniaResource Include="Assets\**" />

    <!-- ClickOnce needs the icon as a real published file: the manifest's
         iconFile (from ApplicationIcon) and the FileAssociation DefaultIcon
         both resolve to the relative path Assets\MdViewer.ico. -->
    <Content Include="Assets\MdViewer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <PublishState>Include</PublishState>
      <Visible>true</Visible>
    </Content>

    <!-- Keep a root-level alias too; some ClickOnce tooling stores the
         file-association icon as just "MdViewer.ico". -->
    <Content Include="Assets\MdViewer.ico" Link="MdViewer.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <PublishState>Include</PublishState>
      <Visible>false</Visible>
    </Content>

    <None Update="Help\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.21" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdViewer.Core\MdViewer.Core.csproj" />
    <ProjectReference Include="..\MdViewer.Rendering\MdViewer.Rendering.csproj" />
  </ItemGroup>

  <Target Name="EnsurePublishReferenceAssemblies" BeforeTargets="CoreCompile"
          Condition="'$(PublishProfile)' != '' and '$(BuildProjectReferences)' == 'false' and '@(ProjectReference)' != ''">
    <MSBuild Projects="@(ProjectReference)"
             Targets="Build"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);BuildProjectReferences=true" />
    <MSBuild Projects="@(ProjectReference)"
             Targets="Build"
             BuildInParallel="true"
             Condition="'$(RuntimeIdentifier)' != ''"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);BuildProjectReferences=true" />
  </Target>

</Project>
